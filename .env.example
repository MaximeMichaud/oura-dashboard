# Oura API (optional unless ingestion profile is enabled)
# Legacy tokens still work when already issued.
OURA_TOKEN=

# OAuth is recommended for new Oura API connections.
# Run: make oauth-setup
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REFRESH_TOKEN=
OURA_ACCESS_TOKEN=
OURA_ACCESS_TOKEN_EXPIRES_AT=
OURA_REDIRECT_URI=http://localhost:8765/callback
OURA_OAUTH_SCOPES=personal daily heartrate tag workout session spo2 ring_configuration stress heart_health

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_DB=oura
POSTGRES_USER=oura
POSTGRES_PASSWORD=oura
POSTGRES_PORT=5432
GRAFANA_DB_PASSWORD=oura_grafana

# Ingestion
HISTORY_START_DATE=2020-01-01
USER_TIMEZONE=America/Toronto
SYNC_INTERVAL_MINUTES=30
OVERLAP_DAYS=8
TIMESERIES_HISTORY_DAYS=90
LOG_LEVEL=INFO

# Grafana
BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
STREAMLIT_PORT=8501
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin
